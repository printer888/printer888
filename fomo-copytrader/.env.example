# ---- core ----
APP_ENV=prod
LOG_LEVEL=INFO
DOMAIN=copytrader.example.com
POSTGRES_PASSWORD=change-me-long-random
# Long random string; required in prod. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
DASHBOARD_TOKEN=

# ---- Solana RPC (use a dedicated provider: Helius, Triton, QuickNode, ...) ----
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
RPC_POLL_INTERVAL_SEC=4

# ---- market data / routing ----
JUPITER_BASE_URL=https://lite-api.jup.ag
# JUPITER_API_KEY=            # with JUPITER_BASE_URL=https://api.jup.ag
DEXSCREENER_BASE_URL=https://api.dexscreener.com

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- trader ----
# Wallet address from the trader's FOMO profile (optional; can be set in the dashboard)
INITIAL_TRADER_WALLET=

# ---- execution: paper by default ----
EXECUTION_MODE=paper
PAPER_STARTING_CAPITAL_USD=1000
PAPER_EXTRA_SLIPPAGE_BPS=50
FUNDING_MINT=USDC
PRIORITY_FEE_LAMPORTS=100000

# Live trading needs ALL of: EXECUTION_MODE=live, the exact phrase below, a keypair
# file mounted as a Docker secret, and arming from the dashboard after each restart.
# LIVE_TRADING_ACK=I_UNDERSTAND_REAL_FUNDS_ARE_AT_RISK
# WALLET_KEYPAIR_PATH=/run/secrets/wallet_keypair
