# Copy to .env and adjust. NEVER commit .env.
# Public Bybit market data needs NO API key. If you ever add one, it must be
# READ-ONLY with no trading and no withdrawal permissions. This app never trades.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Storage — SQLite by default; PostgreSQL recommended for continuous operation
# DATABASE_URL=postgresql+psycopg://cryptointel:change-me@localhost:5432/cryptointel
DATABASE_URL=sqlite:///./cryptointel.db

# Telegram alerts (create a bot with @BotFather; get chat id from getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_COOLDOWN_MINUTES=60

# Universe filter
CORE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT
EXTRA_SYMBOLS=
MAX_UNIVERSE=20
MIN_TURNOVER_24H_USD=20000000
MIN_OPEN_INTEREST_USD=5000000
MAX_SPREAD_BPS=10
MIN_LISTING_DAYS=60

# Analysis / gates
PRIMARY_TIMEFRAME=1h
MIN_SCORE=70
MIN_RR=2.0
MIN_TECHNICAL_POINTS=12
MIN_STRUCTURE_POINTS=10

# Costs — verify against Bybit's current fee schedule for your account tier
TAKER_FEE=0.00055
MAKER_FEE=0.0002
SLIPPAGE_BPS=3
DEFAULT_MMR=0.005

# Paper trading (simulation only)
PAPER_STARTING_EQUITY=10000
RISK_PER_TRADE=0.01
PAPER_LEVERAGE=3
PAPER_AUTO_TRADE=true
MAX_OPEN_PAPER_TRADES=5
DRAWDOWN_ALERT_PCT=10

# Service
SCAN_INTERVAL_SECONDS=120
NEWS_INTERVAL_SECONDS=600
CALENDAR_PATH=config/economic_calendar.json
ENABLE_WEBSOCKET=true
LOG_LEVEL=INFO

# Optional paid on-chain providers (features stay "unavailable" without them)
GLASSNODE_API_KEY=
WHALE_ALERT_API_KEY=
